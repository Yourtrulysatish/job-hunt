{
  "name": "job-hunt",
  "version": "1.0.0",
  "description": "AI-powered job search system — smarter pipeline, web dashboard, SQLite storage, multi-portal scanning",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/web/server.ts",
    "dashboard": "tsx src/web/server.ts",
    "scan": "tsx src/commands/scan.ts",
    "doctor": "tsx src/commands/doctor.ts",
    "migrate": "tsx src/db/migrate.ts",
    "export": "tsx src/commands/export.ts",
    "followup": "tsx src/commands/followup.ts",
    "liveness": "tsx src/commands/liveness.ts",
    "scrape": "tsx src/commands/scrape.ts",
    "scrape:linkedin": "tsx src/commands/scrape.ts --source linkedin",
    "scrape:wellfound": "tsx src/commands/scrape.ts --source wellfound",
    "scan:feeds": "tsx src/commands/scan.ts --source feeds",
    "scan:portals": "tsx src/commands/scan.ts --source portals",
    "brief": "tsx src/commands/brief.ts",
    "record": "tsx src/commands/record.ts",
    "generate": "tsx src/commands/generate.ts",
    "generate:cover": "tsx src/commands/generate.ts --type cover",
    "generate:resume": "tsx src/commands/generate.ts --type resume",
    "gmail": "tsx src/commands/gmail.ts",
    "gmail:auth": "tsx src/commands/gmail.ts auth",
    "linkedin": "tsx src/commands/linkedin.ts",
    "linkedin:auth": "tsx src/commands/linkedin.ts auth"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "career",
    "automation",
    "typescript"
  ],
  "author": "Yourtrulysatish",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "googleapis": "^173.0.0",
    "js-yaml": "^4.1.1",
    "ora": "^8.1.1",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
